# ── Required ────────────────────────────────────────────────────────────────
# Personal Access Token from https://mcp.nirvanahq.com/tokens
NIRVANA_PAT=nt_nirvana_your_token_here

# ── Optional ────────────────────────────────────────────────────────────────
# MCP server URL (default: https://mcp.nirvanahq.com/mcp)
# NIRVANA_MCP_URL=https://mcp.nirvanahq.com/mcp

# Database path (default: ./data/bridge.db)
# NIRVANA_DB_PATH=./data/bridge.db

# Log directory (default: ./logs)
# NIRVANA_LOG_DIR=./logs

# Log level: DEBUG, INFO, WARNING, ERROR (default: INFO)
# NIRVANA_LOG_LEVEL=INFO

# HTTP API bind address (default: 127.0.0.1)
# NIRVANA_HTTP_HOST=127.0.0.1

# HTTP API port (default: 8712)
# NIRVANA_HTTP_PORT=8712

# Maximum retries per task (default: 5)
# NIRVANA_MAX_RETRIES=5

# Base delay between retries in seconds (default: 2)
# NIRVANA_RETRY_DELAY=2.0

# Queue poll interval in seconds (default: 1)
# NIRVANA_QUEUE_POLL=1.0

# MCP timeout in seconds (default: 30)
# NIRVANA_MCP_TIMEOUT=30.0

# Heartbeat interval in seconds (default: 30)
# NIRVANA_HEARTBEAT=30.0

# Reconnect base delay in seconds (default: 1)
# NIRVANA_RECONNECT_DELAY=1.0

# Reconnect max delay in seconds (default: 60)
# NIRVANA_RECONNECT_MAX=60.0

# Circuit breaker: failures before open (default: 5)
# NIRVANA_CB_THRESHOLD=5

# Circuit breaker: recovery timeout seconds (default: 30)
# NIRVANA_CB_RECOVERY=30.0

# Tasks per second rate limit (default: 10)
# NIRVANA_TPS=10.0
