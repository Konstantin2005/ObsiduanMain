### 8. Deployment Configuration

**Dockerfile:**
```dockerfile
FROM node:18-alpine
WORKDIR /app
COPY package*.json ./
RUN npm ci --only=production
COPY . .
EXPOSE 3000
CMD ["npm", "run", "start"]
```

**Docker Compose:**
```yaml
version: '3.8'
services:
  repository-analysis:
    build: .
    ports:
      - "3000:3000"
    environment:
      - DATABASE_URL=postgresql://user:pass@db:5432/analysis
    depends_on:
      - db
  db:
    image: postgres:13
    environment:
      - POSTGRES_DB=analysis
      - POSTGRES_USER=user
      - POSTGRES_PASSWORD=pass
    volumes:
      - postgres_data:/var/lib/postgresql/data
volumes:
  postgres_data:
```

